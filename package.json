{
  "name": "vitakids-api",
  "version": "1.0.0",
  "description": "API REST VitaKids com Express e banco em memoria.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "mocha \"test/**/*.test.js\" --recursive",
    "test:report": "mocha \"test/**/*.test.js\" --recursive --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=vitakids-api-report,html=true,json=true,overwrite=true"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "supertest": "^7.2.2"
  }
}
